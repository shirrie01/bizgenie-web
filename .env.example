VITE_BIZGENIE_API_URL=http://localhost:8080

# Premium Studio onboarding and industry-aware workspace (BG-STUDIO-008-FE). OFF unless this is exactly "true".
# A build-time value: it is never read from the URL, local storage or the backend. Leave unset for the current experience.
# VITE_PREMIUM_STUDIO_ENABLED=false

# Supabase Auth (browser-safe values only — see docs/SUPABASE_AUTH_CONTRACT.md).
# Never put a service-role key, database URL, or any secret key in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# VITE_BIZGENIE_ACCESS_TOKEN, VITE_BIZGENIE_TENANT_ID, VITE_BIZGENIE_PROJECT_ID,
# and VITE_BIZGENIE_BRAND_ID have been removed. The access token now comes from
# the authenticated Supabase session, and tenant/project/brand scope comes only
# from that session's app_metadata (set by the backend) — never from env vars
# or form fields. See docs/SUPABASE_AUTH_CONTRACT.md.
