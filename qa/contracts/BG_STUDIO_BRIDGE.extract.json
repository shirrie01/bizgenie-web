   ],
   "path": "/customer/social/(?:oauth-intents|oauth-complete|connections/{U}/(?:refresh|disconnect)|dispatches|dispatches/{U}/cancel)"
  }
 ],
 "identity_routes": "^/customer/workspace(?:/(?:bootstrap|select|brands))?$",
 "cors": {
  "allowed_request_headers": [
   "authorization",
   "content-type",
   "range"
  ],
  "allow_methods": "exactly the method named in Access-Control-Request-Method",
  "preflight_status": 204,
  "origin": "exactly one configured Studio origin; anything else 403 ORIGIN_FORBIDDEN"
 },
 "scope_rule": "For every route except the identity routes, tenant_id / project_id / brand_id present in the query or JSON body must equal the verified token's trusted scope, otherwise 404 RESOURCE_NOT_AVAILABLE",
 "write_gates": {
  "non_get_head": "STAGING_WRITES_DISABLED",
  "generation_confirm": "GENERATION_CONFIRMATION_DISABLED",
  "social_writes": "SOCIAL_WRITES_DISABLED",
  "stripe_checkout": "STRIPE_CHECKOUT_DISABLED"
 },
 "refusal_codes": [
  "ORIGIN_FORBIDDEN",
  "SERVER_HEADERS_FORBIDDEN",
  "RESOURCE_NOT_AVAILABLE",
  "HEADERS_FORBIDDEN",
  "STAGING_WRITES_DISABLED",
  "GENERATION_CONFIRMATION_DISABLED",
  "SOCIAL_WRITES_DISABLED",
  "BRIDGE_RATE_LIMITED",
  "STUDIO_BRIDGE_TIMEOUT",
  "AUTHENTICATION_REQUIRED",
  "BRIDGE_REQUEST_TOO_LARGE",
  "JSON_REQUIRED",
  "VALIDATION_ERROR",
  "PRIVATE_API_UNAVAILABLE",
  "STRIPE_CHECKOUT_DISABLED",
  "STRIPE_BILLING_VALIDATION_ERROR"
 ],
 "limits": {
  "json_body_bytes": 102400,
  "quote_body_bytes": 16384,
  "max_requests_per_identity_per_minute": 60,
  "timeout_ms": 30000,
  "checkout_body_bytes": 32768
 },
 "checkout": {
  "method": "POST",
  "path": "/billing/stripe/checkout",
  "body": {
   "tenant_id": "identifier, must equal the verified token's trusted tenant (else 404 RESOURCE_NOT_AVAILABLE)",
   "plan_code": "standard | pro",
   "request_id": "identifier /^[A-Za-z0-9][A-Za-z0-9._:-]*$/, stable per checkout intent"
  },
  "unknown_fields": "400 STRIPE_BILLING_VALIDATION_ERROR (strict schema; no price, URL or user id)",
  "success": "201 {checkout_session_id, url}",
  "gate": "needs BG_BRIDGE_ALLOW_WRITES AND BG_BRIDGE_ALLOW_STRIPE_CHECKOUT; both default off; closed gate 403 STRIPE_CHECKOUT_DISABLED",
  "retry_rule": "an unknown outcome is retried with the SAME request_id (Stripe idempotency key = tenant + plan + request_id), never a new one",
  "server_authority": "plan->price, success/cancel URLs and owner membership are decided server-side"
 }
}