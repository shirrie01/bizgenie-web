{
  "name": "bizgenie-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "site:build": "node site/build.mjs",
    "site:build:strict": "node site/build.mjs --strict",
    "site:check": "node site/check.mjs",
    "site:serve": "node site/dev/serve.mjs",
    "site:test": "vitest run site",
    "site:browser": "playwright test --config site/browser/playwright.config.mjs",
    "build:pages": "vite build && node scripts/pages-headers.mjs",
    "acceptance:hosted": "node qa/hosted/hosted-acceptance.mjs",
    "acceptance:sm-properties": "node qa/hosted/sm-properties-acceptance.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.1",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
